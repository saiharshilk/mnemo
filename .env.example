# GitHub OAuth App Client ID
#
# Create an OAuth App at: https://github.com/settings/applications/new
#   Homepage URL: http://localhost:8080  (any URL works; never contacted)
#   Enable Device Flow: MUST be checked  (Settings -> "Devices" -> "Enabled")
# After creation, copy the "Client ID" shown on the app page.
GITHUB_CLIENT_ID=

# Supabase project URL (no trailing slash), e.g. https://abcdefgh.supabase.co
# And the anon public API key from Project Settings -> API.
#
# Requires a `users` table; see README for the exact schema.
SUPABASE_URL=
SUPABASE_ANON_KEY=
